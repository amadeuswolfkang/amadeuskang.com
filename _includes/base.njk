<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="color-scheme" content="light" />
<title>{{ title }} | {{ site.name }}</title>
{% if description %}<meta name="description" content="{{ description }}" />{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}" />

<meta property="og:type" content="{{ ogType or 'website' }}" />
<meta property="og:url" content="{{ site.url }}{{ page.url }}" />
<meta property="og:title" content="{{ title }} | {{ site.name }}" />
{% if description %}<meta property="og:description" content="{{ description }}" />{% endif %}
<meta property="og:image" content="{{ site.url }}{{ ogImage or site.ogImage }}" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ title }} | {{ site.name }}" />
{% if description %}<meta name="twitter:description" content="{{ description }}" />{% endif %}
<meta name="twitter:image" content="{{ site.url }}{{ ogImage or site.ogImage }}" />

<link rel="alternate" type="application/atom+xml" href="{{ site.url }}/feed.xml" title="{{ site.name }} — Blog" />

<!-- Self-hosted fonts (no Google Fonts CDN). Preload only the faces visible
     above the fold so they're in hand at first paint: Michroma (titles) on every
     page; Gentium Regular+Bold on articles (body + headings); Exo 2 on the blog
     index (list/body). All fetched CORS-mode, so crossorigin is required even
     same-origin. -->
<link rel="preload" href="/fonts/Michroma/Michroma-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/Victor_Mono/VictorMono-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin>
{% if ogType == 'article' %}<link rel="preload" href="/fonts/Gentium/Gentium-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/Gentium/Gentium-Bold.woff2" as="font" type="font/woff2" crossorigin>
{% else %}<link rel="preload" href="/fonts/Exo_2/Exo2-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin>{% endif %}
<script>document.documentElement.classList.add('js');</script>

{% raw %}<style>
  /* Self-hosted Gentium (v7) for the article reading font — avoids the
     cross-origin swap/FOUT. The Regular weight is also preloaded in <head> on
     article pages. Only the four faces the article uses are declared. */
  @font-face {
    font-family: 'Gentium';
    src: url('/fonts/Gentium/Gentium-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: optional;
  }
  @font-face {
    font-family: 'Gentium';
    src: url('/fonts/Gentium/Gentium-Italic.woff2') format('woff2');
    font-weight: 400;
    font-style: italic;
    font-display: optional;
  }
  @font-face {
    font-family: 'Gentium';
    src: url('/fonts/Gentium/Gentium-Bold.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: optional;
  }
  @font-face {
    font-family: 'Gentium';
    src: url('/fonts/Gentium/Gentium-BoldItalic.woff2') format('woff2');
    font-weight: 700;
    font-style: italic;
    font-display: optional;
  }

  /* Metric-matched fallback so the Gentium swap causes no layout shift (CLS).
     Overrides are computed from the two fonts' own metric tables — Gentium's
     ascent/descent/avg-advance and Georgia's avg-advance (see TODO.md) — the
     way Capsize/Fontaine do it, so a line of Georgia occupies the same box as
     Gentium until the real face loads. Tuned to the Regular weight. */
  @font-face {
    font-family: 'Gentium Fallback';
    src: local('Georgia');
    size-adjust: 93.72%;
    ascent-override: 101.07%;
    descent-override: 28.65%;
    line-gap-override: 0%;
  }

  /* Self-hosted blog UI/display/mono faces, replacing the former Google Fonts
     link. Exo 2 and Victor Mono are variable (full weight axis in one file), so
     no per-weight decision is baked in. font-display:optional → preloaded faces
     paint correctly from the start, non-preloaded ones fall back for that load
     without a swap (no flash). */
  @font-face {
    font-family: 'Exo 2';
    src: url('/fonts/Exo_2/Exo2-VariableFont_wght.woff2') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: optional;
  }
  @font-face {
    font-family: 'Exo 2';
    src: url('/fonts/Exo_2/Exo2-Italic-VariableFont_wght.woff2') format('woff2');
    font-weight: 100 900;
    font-style: italic;
    font-display: optional;
  }
  @font-face {
    font-family: 'Michroma';
    src: url('/fonts/Michroma/Michroma-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: optional;
  }
  @font-face {
    font-family: 'Victor Mono';
    src: url('/fonts/Victor_Mono/VictorMono-VariableFont_wght.woff2') format('woff2');
    font-weight: 100 700;
    font-style: normal;
    font-display: optional;
  }
  @font-face {
    font-family: 'Victor Mono';
    src: url('/fonts/Victor_Mono/VictorMono-Italic-VariableFont_wght.woff2') format('woff2');
    font-weight: 100 700;
    font-style: italic;
    font-display: optional;
  }

  :root {
    color-scheme: light;
    --c-bg: #f4f2f0;
    --c-surface: #d9d5d2;
    --c-border: #d3cfcc;
    --c-text-1: #2c292b;
    --c-text-2: #5b5658;
    --c-accent: #2c292b;
    --c-code-bg: #e7e3df;
    --c-code-text: #2c292b;
    --c-code-meta: #5b5658;
    --mesh-1: rgba(44, 41, 43, 0.04);
    --mesh-2: rgba(120, 116, 118, 0.06);
    --mesh-3: rgba(147, 148, 154, 0.07);
    --mesh-4: rgba(90, 86, 88, 0.06);
    --mesh-5: rgba(44, 41, 43, 0.05);
    /* Type scale — major third (1.25×), anchored at the 20px reading body
       (--text-md). Each rung is 1.25 the previous, except --text-xs (bumped to
       14px for legibility) and the display step (a hand-tuned clamp). One scale
       for everything (reading + labels). */
    --text-xs: 0.875rem; /* 14px    · labels, dates, kicker, h5, code (hand-tuned up from the 1.25 step) */
    --text-sm: 1rem; /* 16px   · h4 */
    --text-md: 1.25rem; /* 20px   · reading body */
    --text-lg: 1.5625rem; /* 25px   · h3, list-title */
    --text-xl: 1.9531rem; /* ~31px  · h2 */
    --text-2xl: clamp(2.5rem, 6vw, 3.7rem); /* 40→59px · page & article titles */
    /* Article reading-column width. The ToC hangs off the column's right edge
       (absolute, left:100%), so everything that must line up with the column
       reads this one value. The 1280px ToC media query is derived from it:
       760 + 2*(13rem ToC + 2rem gap) = 1240 minimum, plus breathing room. */
    --reading-width: 760px;
  }

  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    background: var(--c-bg);
    min-height: 100vh;
    min-height: 100dvh;
  }

  body {
    min-height: 100vh;
    min-height: 100dvh;
    font-family: 'Exo 2', sans-serif;
    line-height: 1.6;
    color: var(--c-text-1);
    background: var(--c-bg);
  }

  ::selection {
    background: var(--c-accent);
    color: var(--c-bg);
  }

  .bg-mesh {
    position: fixed;
    inset: 0;
    z-index: -2;
    background-color: var(--c-bg);
    background-image:
      radial-gradient(ellipse 80% 60% at 15% 20%, var(--mesh-1) 0%, transparent 70%),
      radial-gradient(ellipse 70% 80% at 85% 75%, var(--mesh-2) 0%, transparent 65%),
      radial-gradient(ellipse 60% 50% at 50% 10%, var(--mesh-3) 0%, transparent 60%),
      radial-gradient(ellipse 90% 70% at 75% 30%, var(--mesh-4) 0%, transparent 55%),
      radial-gradient(ellipse 50% 90% at 20% 80%, var(--mesh-5) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 60% 55%, var(--mesh-2) 0%, transparent 50%);
  }

  .bg-grain {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
    position: relative;
  }

  /* ----- Blog index header ----- */
  .site-header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--c-border);
  }

  .site-title {
    font-family: 'Michroma', sans-serif;
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--c-text-1);
  }

  .hero-line {
    display: block;
    width: fit-content;
    max-width: 100%;
    position: relative;
    overflow: hidden;
    padding-right: 0.08em;
    /* Michroma's "g" descender clips against overflow:hidden at this tight
       line-height; extra bottom room clears it. The mask is height:100% so it
       still covers the full box. */
    padding-bottom: 0.2em;
  }

  .hero-line-inner {
    display: inline-block;
    opacity: 0;
  }

  /* No-JS / JS-disabled fallback: show the title rather than leaving it blank. */
  html:not(.js) .hero-line-inner {
    opacity: 1;
  }

  .hero-line-mask {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 100%;
    background: currentColor;
    pointer-events: none;
    transform-origin: left center;
    z-index: 2;
  }

  /* ----- Blog index list ----- */
  .articles {
    padding-top: 2.5rem;
  }

  .section-label {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 0.25rem 0.75rem;
    border-bottom: 1px solid var(--c-border);
    font-family: 'Victor Mono', monospace;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--c-text-2);
    font-variant-numeric: tabular-nums;
  }

  .article-list {
    list-style: none;
  }

  .article-list-item {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--c-border);
  }

  .article-list-item a {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    align-items: baseline;
    width: 100%;
    gap: 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  .article-list-item:hover {
    background: var(--c-accent);
  }

  .article-list-item:hover .list-title,
  .article-list-item:hover .list-date {
    color: var(--c-bg);
  }

  .list-title {
    min-width: 0;
    font-family: 'Exo 2', sans-serif;
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--c-text-1);
  }

  .list-date {
    font-family: 'Victor Mono', monospace;
    font-size: var(--text-xs);
    color: var(--c-text-2);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* ----- Blog index nav ----- */
  .blog-nav {
    margin-bottom: 2rem;
  }

  /* ----- Article nav ----- */
  .article-nav {
    max-width: var(--reading-width); /* back link aligns with the reading column */
    margin-inline: auto;
  }

  .back-link {
    display: inline-block;
    font-family: 'Victor Mono', monospace;
    font-size: var(--text-xs);
    color: var(--c-text-2);
    text-decoration: none;
    position: relative;
    margin-left: -6px;
    padding: 2px 6px;
    isolation: isolate;
    transition: color 0.2s cubic-bezier(0.85, 0, 0.15, 1);
  }

  .back-link::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--c-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.2s cubic-bezier(0.85, 0, 0.15, 1);
    z-index: -1;
  }

  .back-link.is-hovering {
    color: var(--c-bg);
  }

  .back-link.is-hovering::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* ----- Code block (built by JS around each <pre>) ----- */
  .code-block {
    background: var(--c-code-bg);
    border-radius: 4px;
  }

  .code-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.5rem 0.75rem;
    color: var(--c-code-meta);
    font-family: 'Victor Mono', monospace;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .copy-button {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  /* Muted-icon affordance shared by the code copy button and the heading
     copy-links: faint at rest, full colour + opacity on hover/focus. Opacity
     sits on the control (not the SVGs) so it doesn't fight the heading
     anchor's link↔check crossfade. Scoping the anchor under its heading keeps
     it outranking the generic .article-body a link rules. */
  .copy-button,
  .article-body :is(h2, h3, h4) .heading-anchor {
    color: var(--c-text-2);
    opacity: 0.4;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .copy-button:hover,
  .copy-button:focus-visible,
  .article-body :is(h2, h3, h4) .heading-anchor:hover,
  .article-body :is(h2, h3, h4) .heading-anchor:focus-visible {
    color: var(--c-text-1);
    opacity: 1;
  }

  .copy-button svg {
    width: 1rem;
    height: 1rem;
    stroke: currentColor;
  }

  pre {
    margin: 0;
    padding: 1rem 0.75rem;
    overflow-x: auto;
    color: var(--c-code-text);
    font-size: var(--text-xs);
    line-height: 1.55;
    tab-size: 2;
  }

  pre code {
    font-family: 'Victor Mono', monospace;
  }

  /* ----- Article ----- */
  /* Shell holds the reading column and positions the ToC in the right margin.
     It IS the centred reading column, so the ToC (absolute, left:100%) sits in
     the margin without shifting the reading column off-centre. The width lives
     only here (via --reading-width); .article-page just fills the shell. */
  .article-shell {
    position: relative;
    max-width: var(--reading-width);
    margin-inline: auto;
  }

  .article-page {
    padding-top: 2.5rem;
  }

  /* ----- Table of contents (right margin, wide screens only) ----- */
  .article-toc {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 100%;
    width: 13rem;
    margin-left: 2rem;
  }

  /* Inner sticks while scrolling and stops at the article's end (bounded by the
     absolute aside, which stretches to the shell height via top:0/bottom:0). */
  .toc-inner {
    position: sticky;
    top: 2.5rem;
    max-height: calc(100vh - 5rem);
    overflow-y: auto;
  }

  .toc-title {
    margin: 0 0 0.75rem;
    font-family: 'Gentium', 'Gentium Fallback', serif;
    font-size: var(--text-md);
    color: var(--c-text-2);
  }

  /* The title is also the link back to the top (built in article.njk). Muted
     at rest like the section links below it; the hover/focus brightening is
     the discoverability cue for an otherwise caption-looking label. */
  .toc-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .toc-title a:hover,
  .toc-title a:focus-visible {
    color: var(--c-text-1);
  }

  /* Nested indent guides: each list level carries its own left rail, so depth
     reads as "how many rails deep" an item sits. Real nested <ul>s (built in
     article.njk) rather than faked lines, so the rails are continuous. */
  .toc-list,
  .toc-sublist {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.85rem;
    border-left: 2px solid var(--c-border);
  }

  .toc-link {
    display: block;
    font-family: 'Gentium', 'Gentium Fallback', serif;
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--c-text-2);
    text-decoration: none;
    /* Hanging indent: a long entry's wrapped lines indent under its first line,
       so it reads as one item, not two. The margin adds proximity grouping —
       lines within an entry sit closer than the gap between entries. */
    padding-left: 1em;
    text-indent: -1em;
    margin-bottom: 0.4rem;
    transition: color 0.2s ease;
  }

  .toc-link:hover,
  .toc-link:focus-visible {
    color: var(--c-text-1);
  }

  .toc-link.is-active {
    color: var(--c-text-1);
    font-weight: 700;
  }

  /* Not enough right margin below this width — hide rather than crowd. */
  @media (max-width: 1280px) {
    .article-toc {
      display: none;
    }
  }

  .article-header {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--c-border);
  }

  .article-kicker {
    font-family: 'Victor Mono', monospace;
    font-size: var(--text-xs);
    color: var(--c-text-2);
    font-variant-numeric: tabular-nums;
  }

  .article-title {
    margin-top: 0.5rem;
    font-family: 'Michroma', sans-serif;
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--c-text-1);
  }

  .article-body {
    padding-top: 2rem;
    font-family: 'Gentium', 'Gentium Fallback', serif;
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--c-text-1);
  }

  .article-body > * + * {
    margin-top: 1.25rem;
  }

  .article-body p,
  .article-body ul,
  .article-body ol,
  .article-body blockquote {
    max-width: 72ch;
  }

  .article-body h2 {
    margin-top: 3.5rem;
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .article-body h3 {
    margin-top: 2.5rem;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .article-body h4 {
    margin-top: 1.75rem;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .article-body h5 {
    margin-top: 1.5rem;
    font-family: 'Victor Mono', monospace;
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-2);
  }

  /* Butterick's minimalism: one clean marker at every nesting level — the disc.
     This overrides the browser's disc/circle/square cascade (it matches every
     nested <ul> and outranks the UA ul-ul rules), so depth is signalled by the
     indentation step, not by swapping glyphs. Markers stay full-strength, in
     keeping with the full-weight (1) numerals. */
  .article-body ul {
    padding-left: 1.4rem;
    list-style-type: disc;
  }

  /* Ordered lists render with parenthetical markers — (1), (2), (3) — via a
     CSS counter, matching the parenthetical-number style used in prose. Just
     author a normal markdown ordered list (1. 2. 3.) and it picks this up.
     Scoped to ol > li so nested <ul> bullets are left alone. */
  .article-body ol {
    list-style: none;
    counter-reset: parens;
    padding-left: 0;
  }

  .article-body ol > li {
    counter-increment: parens;
    position: relative;
    padding-left: 2.4rem;
  }

  .article-body ol > li::before {
    content: "(" counter(parens) ")";
    position: absolute;
    left: 0;
    color: var(--c-text-1);
    font-variant-numeric: tabular-nums;
  }

  .article-body li {
    color: var(--c-text-1);
  }

  .article-body li + li {
    margin-top: 0.4rem;
  }

  .article-body strong {
    font-weight: 600;
    color: var(--c-text-1);
  }

  .article-body em {
    font-style: italic;
  }

  .article-body a {
    color: var(--c-text-1);
    text-decoration: underline;
    text-decoration-color: var(--c-text-2);
    text-underline-offset: 0.15em;
    transition: text-decoration-color 0.2s ease;
  }

  .article-body a:hover {
    text-decoration-color: var(--c-text-1);
  }

  .article-body blockquote {
    border-left: 2px solid var(--c-border);
    padding-left: 1rem;
    color: var(--c-text-2);
  }

  .article-body blockquote strong {
    color: var(--c-text-1);
  }

  /* Inline code only — code:not(pre code) excludes the <code> inside any fenced
     <pre> block, including one nested in a list item or blockquote, so block
     code never picks up the inline pill regardless of where it sits. */
  .article-body :is(p, li, blockquote) code:not(pre code) {
    font-family: 'Victor Mono', monospace;
    font-size: 0.85em;
    padding: 0.12em 0.35em;
    background: rgba(44, 41, 43, 0.08);
    color: var(--c-text-1);
    border-radius: 3px;
  }

  .article-body .code-block {
    margin-top: 1.5rem;
  }

  /* Markdown wraps a standalone image in its own <p>, so vertical rhythm comes
     from the sibling-margin rule; the image just stays responsive within the
     column with a light frame to seat screenshots against the page. */
  .article-body img,
  .article-body video {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--c-border);
    border-radius: 4px;
  }

  /* Image-as-link wrapper (added client-side): plain block, no text underline,
     with a subtle border cue on hover that the image opens full-size. */
  .article-body a.image-link {
    display: block;
    text-decoration: none;
  }

  .article-body a.image-link:hover img {
    border-color: var(--c-text-2);
  }

  /* Breathing room when a #section deep link lands: the heading sits a bit below
     the viewport top instead of flush against it. Pure scroll behaviour — does
     not affect document layout. (Wikipedia does the same via scroll offset.) */
  .article-body :is(h2, h3, h4) {
    scroll-margin-top: 2rem;
  }

  /* Section copy-link icon (added client-side): a chain-link glyph at the end of
     each heading, always visible in the faintest palette colour and brightening
     on hover/focus. On copy it crossfades to a checkmark that draws itself in —
     stroke-dashoffset animated via the path's pathLength="1", no measuring. */
  .article-body :is(h2, h3, h4) .heading-anchor {
    position: relative;
    display: inline-block;
    /* rem (not em) → same icon size on every heading, and it stays within the
       line box so it never shifts layout. */
    width: 1.25rem;
    height: 1.25rem;
    margin-left: 0.5em;
    /* `middle` centres on the x-height; headings read from their cap-height, so
       nudge up to the optical centre. em → scales with each heading; transform →
       no line-box change, so still no layout shift. */
    vertical-align: middle;
    transform: translateY(-0.1em);
    /* Rest/hover colour + opacity come from the shared muted-icon rule in the
       code-block section above. */
    text-decoration: none;
  }

  /* Expanded hit target: comfortable to click/tap without enlarging the glyph
     or touching layout (absolute → out of flow). */
  .article-body :is(h2, h3, h4) .heading-anchor::after {
    content: "";
    position: absolute;
    inset: -0.5rem;
  }

  .heading-anchor svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: opacity 0.2s ease;
  }

  /* Check starts hidden + undrawn, in the accent color. */
  .heading-anchor .icon-check {
    opacity: 0;
    color: var(--c-accent);
  }

  .heading-anchor .icon-check path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.35s ease;
  }

  /* On success: link fades out, check fades in and draws. */
  .heading-anchor.is-copied .icon-link {
    opacity: 0;
  }

  .heading-anchor.is-copied .icon-check {
    opacity: 1;
  }

  .heading-anchor.is-copied .icon-check path {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .heading-anchor .icon-check path {
      transition: none;
    }
  }

  @media (max-width: 480px) {
    .page {
      padding: 4rem 1rem;
    }

    .article-list-item a {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line-inner {
      opacity: 1;
    }

    .hero-line-mask {
      display: none;
    }
  }
</style>{% endraw %}
</head>

