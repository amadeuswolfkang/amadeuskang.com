---
layout: base.njk
ogType: article
---
<main class="page">
  <nav class="article-nav">
    <a class="back-link" href="/blog/">&larr; Blog</a>
  </nav>

  <div class="article-shell">
    <article class="article-page">
      <header class="article-header">
        <p class="article-kicker">{{ date | isoDate }}{% if tag %} / {{ tag }}{% endif %}</p>
        <h1 class="article-title">{{ title }}</h1>
      </header>
      <div class="article-body">
        {{ content | safe }}
      </div>
    </article>
    <aside class="article-toc" aria-label="Table of contents" hidden></aside>
  </div>
</main>

{% raw %}<script>
  // Progressive enhancement for the rendered article body. Each feature is a
  // self-contained pass; the orchestration at the bottom shows the run order.
  (function () {
    const body = document.querySelector('.article-body');
    if (!body) return;

    // How long copy confirmations stay visible before reverting.
    const CONFIRM_MS = 1200;

    // Shared clipboard write for both copy affordances. navigator.clipboard is
    // undefined outside a secure context, and writeText() rejects if the
    // document isn't focused or permission is denied; each outcome routes to a
    // caller-supplied handler so a click never throws or stalls silently.
    function writeClipboard(text, on) {
      if (!navigator.clipboard) {
        on.unavailable();
        return;
      }
      navigator.clipboard.writeText(text).then(on.copied, on.failed);
    }

    // Wrap each rendered <pre> in code-block chrome: a language label and a
    // working copy button.
    function enhanceCodeBlocks() {
      const COPY_ICON =
        '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">' +
        '<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>' +
        '<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';

      // pre.mermaid is diagram source, not code; renderDiagrams owns it.
      body.querySelectorAll('pre:not(.mermaid)').forEach((pre) => {
        const code = pre.querySelector('code');
        const langClass = code && [...code.classList].find((c) => c.startsWith('language-'));
        const lang = langClass ? langClass.slice('language-'.length) : 'code';

        const block = document.createElement('div');
        block.className = 'code-block';
        block.innerHTML =
          '<div class="code-header"><span>' + lang + '</span>' +
          '<button class="copy-button" type="button" aria-label="Copy code" title="Copy code">' + COPY_ICON + '</button></div>';
        pre.parentNode.insertBefore(block, pre);
        block.appendChild(pre);

        const button = block.querySelector('.copy-button');
        const flash = (label) => {
          button.setAttribute('aria-label', label);
          button.title = label;
          setTimeout(() => {
            button.setAttribute('aria-label', 'Copy code');
            button.title = 'Copy code';
          }, CONFIRM_MS);
        };
        button.addEventListener('click', () => {
          writeClipboard((code || pre).textContent, {
            copied: () => flash('Copied'),
            unavailable: () => flash('Copy unavailable'),
            failed: () => flash('Copy failed'),
          });
        });
      });
    }

    // Mermaid diagrams: ```mermaid fences arrive as <pre class="mermaid">
    // holding raw diagram source (fence override in eleventy.config.mjs).
    // The library is heavy (~3.5 MB), so it is injected only on pages that
    // actually contain a diagram; every other article pays zero bytes. Until
    // the script lands (or if it fails to load) the source stays visible as
    // preformatted text, which is a readable fallback rather than a blank.
    function renderDiagrams() {
      if (!document.querySelector('pre.mermaid')) return;
      const script = document.createElement('script');
      script.src = '/vendor/mermaid/mermaid.min.js';
      script.onload = () => {
        // Theme every diagram from the site's own CSS tokens (read live from
        // the stylesheet, so diagrams can never drift from the page palette)
        // instead of a stock Mermaid theme. 'base' is the one Mermaid theme
        // designed to be driven entirely by themeVariables.
        const css = getComputedStyle(document.documentElement);
        const token = (name) => css.getPropertyValue(name).trim();
        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          themeVariables: {
            fontFamily: "'Exo 2', sans-serif",
            background: token('--c-bg'),
            primaryColor: token('--c-code-bg'),
            primaryTextColor: token('--c-text-1'),
            primaryBorderColor: token('--c-accent'),
            lineColor: token('--c-text-2'),
            edgeLabelBackground: token('--c-bg'),
            titleColor: token('--c-text-1'),
          },
        });
        mermaid.run({ querySelector: 'pre.mermaid' });
      };
      document.head.appendChild(script);
    }

    // Make each image open the full file in a new tab (skip ones already linked).
    function linkifyImages() {
      body.querySelectorAll('img').forEach((img) => {
        if (img.closest('a')) return;
        const link = document.createElement('a');
        link.href = img.getAttribute('src');
        link.target = '_blank';
        link.rel = 'noopener';
        link.className = 'image-link';
        img.parentNode.insertBefore(link, img);
        link.appendChild(img);
      });
    }

    // Section copy-links: a chain-link icon at the end of each heading (ids are
    // injected at build time) that copies a direct URL to that section. Success
    // is confirmed by swapping to a checkmark that draws itself in.
    function addHeadingAnchors(headings) {
      const LINK_ICON =
        '<svg class="icon-link" viewBox="0 0 24 24" aria-hidden="true">' +
        '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>' +
        '<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>';
      const CHECK_ICON =
        // Path starts at the left arm so the stroke draws left-to-right (the
        // natural direction a check is written); same shape as Feather's check.
        '<svg class="icon-check" viewBox="0 0 24 24" aria-hidden="true">' +
        '<path pathLength="1" d="M4 12 9 17 20 6"></path></svg>';

      headings.forEach((heading) => {
        const anchor = document.createElement('a');
        anchor.className = 'heading-anchor';
        anchor.href = '#' + heading.id;
        anchor.setAttribute('aria-label', 'Copy link to this section');
        anchor.title = 'Copy link to section';
        anchor.innerHTML = LINK_ICON + CHECK_ICON;
        heading.appendChild(anchor);

        let revert = null;
        anchor.addEventListener('click', (e) => {
          e.preventDefault();
          const url = location.href.split('#')[0] + '#' + heading.id;
          const confirm = () => {
            anchor.classList.add('is-copied');
            if (revert) clearTimeout(revert);
            revert = setTimeout(() => anchor.classList.remove('is-copied'), CONFIRM_MS);
          };
          // Whether clipboard is missing or the write failed, at least put the
          // URL in the address bar.
          const fallback = () => {
            location.hash = heading.id;
          };
          writeClipboard(url, { copied: confirm, unavailable: fallback, failed: fallback });
        });
      });
    }

    // Table of contents (shown in the right margin on wide screens; hidden via
    // CSS on narrow ones). Built from the same h2/h3/h4[id] set, with scroll-spy
    // highlighting whichever section is currently near the top of the viewport.
    function buildTableOfContents(headings, labels) {
      const toc = document.querySelector('.article-toc');
      if (!toc || headings.length < 2) return;

      const inner = document.createElement('div');
      inner.className = 'toc-inner';
      // The title doubles as the route back to the top; the article title and
      // intro have no ToC entry, so this label is the only way back up. A real
      // link (not a click handler on the <p>) keeps it keyboard-focusable and
      // announced. The jump is instant to match the section links, and the
      // section hash is stripped so the URL doesn't claim a section you left.
      const title = document.createElement('p');
      title.className = 'toc-title';
      const topLink = document.createElement('a');
      topLink.href = '#';
      topLink.textContent = 'On this page';
      topLink.title = 'Back to top';
      topLink.setAttribute('aria-label', 'Back to top');
      topLink.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo(0, 0);
        history.replaceState(null, '', location.pathname + location.search);
      });
      title.appendChild(topLink);
      const list = document.createElement('ul');
      list.className = 'toc-list';

      // Build a nested <ul> tree from the flat h2/h3/h4 sequence so each depth
      // gets its own rail. A stack tracks the open list at each level; child
      // <ul>s are created lazily so a level with no children adds no empty rail.
      const linkById = new Map();
      const levelOf = (h) => parseInt(h.tagName.charAt(1), 10);
      // Sentinel at level 1 (shallower than any h2) so the root list is always
      // the parent for top-level headings and the pop loop below never empties.
      const stack = [{ level: 1, ul: list, li: null }];
      headings.forEach((heading) => {
        const level = levelOf(heading);
        // Pop siblings and deeper entries so the stack top is this heading's
        // nearest shallower ancestor: the list it should be appended under.
        while (stack.length > 1 && stack[stack.length - 1].level >= level) stack.pop();
        const top = stack[stack.length - 1];
        if (!top.ul) {
          top.ul = document.createElement('ul');
          top.ul.className = 'toc-sublist';
          top.li.appendChild(top.ul);
        }
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'toc-link';
        a.href = '#' + heading.id;
        // Labels were captured before the anchor pass, so they can't inherit
        // any text a future anchor icon or hidden a11y span might carry.
        a.textContent = labels.get(heading);
        // Trapped entries need the scroll position corrected; every other link
        // is left to the browser. See segmentMidpoint below.
        a.addEventListener('click', (e) => {
          const y = segmentMidpoint(heading.id);
          if (y === null) return;
          e.preventDefault();
          window.scrollTo(0, y);
          history.pushState(null, '', '#' + heading.id);
        });
        li.appendChild(a);
        top.ul.appendChild(li);
        linkById.set(heading.id, a);
        stack.push({ level: level, ul: null, li: li });
      });

      inner.appendChild(title);
      inner.appendChild(list);
      toc.appendChild(inner);
      toc.hidden = false;

      // aria-current mirrors the visual highlight, so the ToC announces which
      // section you are in rather than looking active and reading inert. The
      // value matches what the native :target-current feature is specified to
      // expose, so the two stay consistent if this is ever swapped for it.
      let activeId = null;
      const setActive = (id) => {
        if (id === activeId) return;
        const prev = activeId && linkById.get(activeId);
        if (prev) {
          prev.classList.remove('is-active');
          prev.removeAttribute('aria-current');
        }
        activeId = id;
        const link = id && linkById.get(id);
        if (link) {
          link.classList.add('is-active');
          link.setAttribute('aria-current', 'true');
        }
      };

      // Fraction of the viewport height, measured from the top, that counts as
      // the "active" zone: a heading activates once its top edge enters it.
      const ACTIVE_BAND = 0.25;
      // Sub-pixel slack, so rounding can't strand a heading a fraction of a
      // pixel short of activating. Pure slop; nothing depends on its value.
      const SLACK = 2;

      // NodeList has forEach but not map/findIndex, and the threshold pass
      // wants both.
      const items = Array.from(headings);

      // The scroll-spy primitive: each heading's ACTIVATION THRESHOLD, the
      // scrollY it takes over at. Heading i owns the scroll interval
      // (t[i], t[i + 1]], so the rule is one line (active is the last threshold
      // scrolled past) and the property we care about, that every heading owns
      // a nonempty stretch of scroll and the stretches run in document order,
      // holds by construction of a strictly increasing list.
      //
      // A heading takes over at the LATER of two crossings:
      //
      //   its own top entering the band, and
      //   the heading before it clearing the top of the viewport.
      //
      // The second term is what makes the topmost heading in the band win
      // rather than the lowest: after a ToC click or a deep link the target and
      // the following heading often sit in the band together, and lowest-wins
      // would bold the section after the one you landed on.
      //
      // Both crossings are exclusive, which is why the scan below compares with
      // > and not >=. An anchor jump lands scrollY exactly on the target's
      // document top, which is exactly the next heading's second term, so >=
      // would let the next heading tie and win: the very case the term exists
      // to fix, and one that never arises while scrolling by hand. That is also
      // why a threshold landing exactly ON maxScroll counts as unreachable
      // below; there is no scroll position strictly past it.
      //
      // Trailing headings whose thresholds land at or past the end of the
      // scrollable range can never be reached: the page runs out of scroll
      // while their tops are still mid-viewport. Thresholds increase in
      // document order, so those form a suffix, and we respace it evenly across the
      // scroll that remains. Each still takes its turn in order and the last
      // lands at the very bottom. That is the whole of the old "end zone", now
      // a preprocessing step on this rule's input instead of a second regime
      // running beside it.
      //
      // Positions are measured per call, never cached, so late image loads,
      // lazy diagrams, and resizes can't leave thresholds stale. All reads
      // happen together, before any class writes, so a frame costs one layout.
      const thresholds = (maxScroll) => {
        const bandBottom = window.innerHeight * ACTIVE_BAND;
        // Headings that aren't rendered (a collapsed <details>, an inactive tab
        // panel, anything display:none) report an all-zero rect, which would
        // compute to a threshold that tracks the scroll position instead of the
        // document, letting a phantom entry capture the highlight. Drop them
        // here rather than at build time, so a section that is revealed later
        // rejoins the spy on the next frame.
        const live = [];
        const tops = [];
        for (const heading of items) {
          const rect = heading.getBoundingClientRect();
          if (rect.width === 0 && rect.height === 0) continue;
          live.push(heading);
          tops.push(rect.top + window.scrollY);
        }
        const t = tops.map((top, i) => {
          const entersBand = top - bandBottom - SLACK;
          const predecessorClearsTop = i === 0 ? -Infinity : tops[i - 1];
          return Math.max(entersBand, predecessorClearsTop);
        });
        const first = t.findIndex((x) => x >= maxScroll);
        if (first !== -1) {
          // The zone starts at the last reachable threshold (or the page top if
          // nothing is reachable), and the reachable heading holds the first
          // segment, since the first synthetic threshold sits one step past it.
          const zoneStart = first === 0 ? 0 : t[first - 1];
          const step = (maxScroll - zoneStart) / (t.length - first + 1);
          for (let i = first; i < t.length; i++) t[i] = zoneStart + step * (i - first + 1);
        }
        return { live: live, t: t };
      };

      // Anchor navigation scrolls to a heading's document top, clamped to the
      // scrollable range. Near the end of the page that clamp can drop you
      // outside the heading's own segment: click a section whose top sits past
      // maxScroll and you land at the bottom, where the largest threshold
      // passed belongs to a LATER heading, so the ToC bolds the wrong entry.
      //
      // The criterion is the landing position, not whether the heading was
      // respaced. Those differ: a heading can have a reachable threshold (so
      // the respacing leaves it alone) and still have an unreachable document
      // top (so the browser overshoots it). Asking "would the browser land
      // inside this heading's segment" covers both, and out-of-order layouts
      // besides. Returns null when the browser gets it right.
      //
      // Thresholds are recomputed here rather than remembered from render
      // time, so a layout change in between (late image, lazy diagram) can't
      // stale them. That the model is a pure function of current layout is
      // what makes correcting its own edge case this cheap.
      const segmentMidpoint = (id) => {
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (maxScroll <= 0) return null;
        const measured = thresholds(maxScroll);
        const i = measured.live.findIndex((heading) => heading.id === id);
        if (i === -1) return null;
        const t = measured.t;
        const next = i + 1 < t.length ? t[i + 1] : maxScroll;
        const top = measured.live[i].getBoundingClientRect().top + window.scrollY;
        const landing = Math.min(top, maxScroll);
        if (landing > t[i] && landing <= next) return null;
        return (t[i] + next) / 2;
      };

      const electActive = () => {
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const measured = thresholds(maxScroll);
        const live = measured.live;
        const t = measured.t;
        if (!live.length) return null;
        if (maxScroll <= 0) return live[0].id;
        // The LARGEST threshold scrolled past, not the last one in document
        // order. Those coincide while thresholds increase down the page, which
        // is the normal case, but float, grid order and absolute positioning
        // can put a heading's box above its predecessor's. Taking the maximum
        // needs no such assumption; ties go to the earliest heading, since a
        // later one has to beat the running best outright.
        // None passed means we sit above the first heading's activation point,
        // so the first entry holds; that also keeps a mid-article reload on the
        // current section rather than section one, since every threshold above
        // the viewport counts as passed. Overscroll clamps for free: past
        // maxScroll every threshold is passed.
        let active = 0;
        let best = -Infinity;
        for (let i = 0; i < t.length; i++) {
          if (window.scrollY > t[i] && t[i] > best) {
            best = t[i];
            active = i;
          }
        }
        return live[active].id;
      };

      // One driver, no handoff. A rAF-throttled scroll listener rather than an
      // IntersectionObserver: an observer earns its keep when it removes the
      // always-on scroll listener entirely, and this rule needs positions on
      // every scroll regardless, so an observer would only add a second driver
      // to coordinate with. Throttling to a frame also collapses the layout
      // reads a per-event handler would force.
      let raf = 0;
      const update = () => {
        raf = 0;
        setActive(electActive());
      };
      const schedule = () => {
        if (!raf) raf = requestAnimationFrame(update);
      };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      // Layout can shift without any scroll (late images, the lazy Mermaid
      // pass), which moves every threshold.
      new ResizeObserver(schedule).observe(document.body);
      // A deep link to a trapped heading lands wrong for the same reason a
      // click on one does, so correct it before seeding rather than after, and
      // let the seed read the corrected position.
      if (location.hash) {
        const y = segmentMidpoint(decodeURIComponent(location.hash.slice(1)));
        if (y !== null) window.scrollTo(0, y);
      }
      // Seed the at-rest highlight synchronously, so the ToC is never blank for
      // a frame on load or after a deep-link jump.
      update();
    }

    // Run the passes.
    const headings = body.querySelectorAll('h2[id], h3[id], h4[id]');

    // Capture ToC labels before addHeadingAnchors mutates the headings, so the
    // labels can never pick up text from the injected anchors. (This matters
    // for the deferred wide-viewport ToC build below, which always runs after
    // the anchor pass.)
    const tocLabels = new Map();
    headings.forEach((heading) => tocLabels.set(heading, heading.textContent.trim()));

    enhanceCodeBlocks();
    renderDiagrams();
    linkifyImages();
    addHeadingAnchors(headings);

    // The ToC is display:none at 1280px and below (see base.njk), so narrow
    // viewports shouldn't pay to build it, observe every heading, and listen
    // to scroll for a component they can never show. Build it lazily the
    // first time the viewport is wide enough; "change" fires only on media
    // query crossings, so the listener stays inert on phones.
    const tocViewport = window.matchMedia('(min-width: 1281px)');
    if (tocViewport.matches) {
      buildTableOfContents(headings, tocLabels);
    } else {
      tocViewport.addEventListener('change', function onWide(e) {
        if (!e.matches) return;
        tocViewport.removeEventListener('change', onWide);
        buildTableOfContents(headings, tocLabels);
      });
    }
  })();
</script>{% endraw %}
