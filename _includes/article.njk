---
layout: base.njk
ogType: article
---
<main class="page">
  <nav class="article-nav">
    <a class="back-link" href="/blog/">&larr; Blog</a>
  </nav>

  <article class="article-page">
    <header class="article-header">
      <p class="article-kicker">{{ date | isoDate }}{% if tag %} / {{ tag }}{% endif %}</p>
      <h1 class="article-title">{{ title }}</h1>
    </header>
    <div class="article-body">
      {{ content | safe }}
    </div>
  </article>
</main>

{% raw %}<script>
  // Progressive enhancement: wrap each rendered <pre> in code-block chrome
  // with a language label and a working copy button.
  (function () {
    const body = document.querySelector('.article-body');
    if (!body) return;

    const COPY_ICON =
      '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
      '<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>' +
      '<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';

    body.querySelectorAll('pre').forEach((pre) => {
      const code = pre.querySelector('code');
      const langClass = code && [...code.classList].find((c) => c.startsWith('language-'));
      const lang = langClass ? langClass.slice('language-'.length) : 'code';

      const block = document.createElement('div');
      block.className = 'code-block';
      block.innerHTML =
        '<div class="code-header"><span>' + lang + '</span>' +
        '<button class="copy-button" type="button" aria-label="Copy code" title="Copy code">' + COPY_ICON + '</button></div>';
      pre.parentNode.insertBefore(block, pre);
      block.appendChild(pre);

      const button = block.querySelector('.copy-button');
      const flash = (label) => {
        button.setAttribute('aria-label', label);
        button.title = label;
        setTimeout(() => {
          button.setAttribute('aria-label', 'Copy code');
          button.title = 'Copy code';
        }, 1200);
      };
      button.addEventListener('click', () => {
        // navigator.clipboard is undefined outside a secure context and
        // writeText() rejects if the document isn't focused or permission is
        // denied — handle both so the click never throws or stalls silently.
        if (!navigator.clipboard) {
          flash('Copy unavailable');
          return;
        }
        navigator.clipboard.writeText((code || pre).textContent).then(
          () => flash('Copied'),
          () => flash('Copy failed')
        );
      });
    });
  })();
</script>{% endraw %}
